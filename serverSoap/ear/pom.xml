		</dependency>

		<dependency>
			<groupId>book1</groupId>
			<artifactId>soap</artifactId>
			<version>1</version>
			<type>war</type>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.wildfly.plugins</groupId>
				<artifactId>wildfly-maven-plugin</artifactId>
				<version>5.1.5.Final</version>
				<configuration>
					<port>10090</port>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
